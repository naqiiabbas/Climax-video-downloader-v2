# Copy to .env and fill in. Never commit .env.

PORT=8000
NODE_ENV=production

# Shared secret the mobile app sends as the `x-api-key` header.
# Generate one with: openssl rand -hex 48
API_KEY=

# Public origin used to build download URLs. Leave empty to use the request host.
# Example: https://api.example.com
PUBLIC_BASE_URL=

# Comma-separated origins, or * for any (mobile apps send no Origin header).
CORS_ORIGIN=*

# Seconds a converted mp4 stays on disk before it is auto-deleted.
CACHE_TTL_SECONDS=3600

# Paths (relative paths resolve from the project root).
DOWNLOADS_DIR=downloads
COOKIES_PATH=cookies.txt

# Binary locations. Defaults: bundled .exe on Windows,
# /usr/local/bin/yt-dlp and /usr/bin/ffmpeg on Linux.
# YTDLP_PATH=
# FFMPEG_PATH=

# Only used by `npm run refresh-cookies`. Prefer uploading cookies.txt instead.
IG_USERNAME=
IG_PASSWORD=

# TikTok rate-limits anonymous extraction; the server retries this many times.
TIKTOK_RETRIES=8
# Routes TikTok through the mobile API host. Empty = yt-dlp default extractor.
TIKTOK_API_HOSTNAME=api22-normal-c-useast2a.tiktokv.com

# Docker network of the reverse proxy the API attaches to (Caddy on the VPS).
# Find it: docker inspect uzy-caddy-1 --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}'
CADDY_NETWORK=uzy_default

# Only used if you bind a host port instead of joining the proxy network.
# Unused on the Caddy setup, where no host port is bound.
HOST_PORT=8090

# Default height cap for /api/downloads/prepare only (best|1080|720|480|360|240).
# /api/vimeo and /api/dailymotion have no default and require ?quality=.
# Nothing above 1080 is served: 1440 and 2160 are not accepted anywhere.
DEFAULT_QUALITY=1080
# Hard ceiling on a single merge job, in ms.
MERGE_TIMEOUT_MS=600000

# (AUTO_CONVERT was removed. /api/vimeo and /api/dailymotion no longer convert
# by default — they convert only when the request carries ?quality=, so there
# is no default behaviour left to switch off. A leftover value is ignored.)

# Download history (Supabase). Both must be set or /api/history returns 503.
# Use the ANON / publishable key, never the service_role key: the server
# forwards each user's own access token so RLS enforces isolation, and a
# service_role key here would bypass RLS entirely.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
