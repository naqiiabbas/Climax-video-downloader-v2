# Copy to .env and fill in. Never commit .env.

PORT=8000
NODE_ENV=production

# Shared secret the mobile app sends as the `x-api-key` header.
# Generate one with: openssl rand -hex 48
API_KEY=

# Public origin used to build download URLs. Leave empty to use the request host.
# Example: https://api.example.com
PUBLIC_BASE_URL=

# Comma-separated origins, or * for any (mobile apps send no Origin header).
CORS_ORIGIN=*

# Seconds a converted mp4 stays on disk before it is auto-deleted.
CACHE_TTL_SECONDS=3600

# Paths (relative paths resolve from the project root).
DOWNLOADS_DIR=downloads
COOKIES_PATH=cookies.txt

# Binary locations. Defaults: bundled .exe on Windows,
# /usr/local/bin/yt-dlp and /usr/bin/ffmpeg on Linux.
# YTDLP_PATH=
# FFMPEG_PATH=

# Only used by `npm run refresh-cookies`. Prefer uploading cookies.txt instead.
IG_USERNAME=
IG_PASSWORD=

# TikTok rate-limits anonymous extraction; the server retries this many times.
TIKTOK_RETRIES=8
# Routes TikTok through the mobile API host. Empty = yt-dlp default extractor.
TIKTOK_API_HOSTNAME=api22-normal-c-useast2a.tiktokv.com

# Host port for docker-compose.vps.yml (bound to 127.0.0.1 only).
# Must be free on the VPS — check with: sudo ss -tlnp | grep ':8090'
HOST_PORT=8090

# Default height cap for /api/downloads/prepare (best|2160|1440|1080|720|480|360|240).
DEFAULT_QUALITY=1080
# Hard ceiling on a single merge job, in ms.
MERGE_TIMEOUT_MS=600000
