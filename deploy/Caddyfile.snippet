# Append this block to the existing Caddyfile on the VPS:
#
#   /opt/Uzy/caddy/Caddyfile        (host path)
#   /etc/caddy/Caddyfile            (as seen inside uzy-caddy-1)
#
# It is bind-mounted, so editing it on the host is immediately visible to the
# container. BACK IT UP FIRST — this file also serves the live uzy site:
#
#   sudo cp /opt/Uzy/caddy/Caddyfile /opt/Uzy/caddy/Caddyfile.bak
#   sudo nano /opt/Uzy/caddy/Caddyfile        # append the block below
#
# Then validate, and only reload if validation passes:
#
#   docker exec uzy-caddy-1 caddy validate --config /etc/caddy/Caddyfile
#   docker exec uzy-caddy-1 caddy reload   --config /etc/caddy/Caddyfile
#
# Use `reload`, never `restart` — a reload is graceful and does not interrupt
# the uzy site; a restart drops its connections.
#
# Point a DNS A record for the subdomain at this VPS BEFORE reloading, or
# Caddy's ACME challenge will fail. Caddy then issues and renews TLS itself —
# there is no certbot step.
#
# >>> Replace downloader.example.com with your actual subdomain. <<<

downloader.example.com {
	# `video_downloader_api` is the container name and 8000 its internal port.
	# This resolves over the uzy_default Docker network, so no host port is
	# involved and nothing can collide with MinIO on 9000 or the uzy services.
	reverse_proxy video_downloader_api:8000 {
		transport http {
			dial_timeout 30s

			# Extraction runs yt-dlp (up to ~30s) and a merge job can run for
			# minutes before the first response byte. Caddy's defaults would
			# abort these mid-job.
			response_header_timeout 900s
			read_timeout 900s
			write_timeout 900s
		}
	}

	# cookies.txt uploads. Everything else is a short GET.
	request_body {
		max_size 10MB
	}

	# Deliberately no `encode` directive: the large responses here are mp4
	# files, already compressed. Gzipping them would waste CPU for nothing.
}
