# Save this as its own drop-in file on the VPS:
#
#   /opt/Uzy/caddy/conf.d/video-downloader.caddy   (host path)
#   /etc/caddy/conf.d/video-downloader.caddy       (inside uzy-caddy-1)
#
# Both are bind-mounted, so host edits are visible to the container
# immediately. Line 20 of the main Caddyfile is
# `import /etc/caddy/conf.d/*.caddy`, so the filename MUST end in .caddy.
#
# DO NOT append this to /opt/Uzy/caddy/Caddyfile. That file also serves the
# live uzy site, and the documented "back it up first, restore it to roll
# back" pattern silently deletes this block: the backup predates it. That is
# exactly what took this API offline from 2026-09-11 to 2026-09-24 — the
# symptom was a TLS handshake failure (alert 80, "no peer certificate
# available") that looked like a broken certificate but was really a missing
# site block. Keeping it in conf.d makes that impossible.
#
# ---------------------------------------------------------------------------
# HOSTNAME: <VPS_IP>.nip.io
# ---------------------------------------------------------------------------
# There is no domain yet, and Let's Encrypt cannot issue certificates for bare
# IP addresses. nip.io resolves <anything>.<ip>.nip.io straight to that IP with
# no DNS account or configuration, and because it is a real hostname Caddy can
# obtain a genuine Let's Encrypt certificate for it.
#
# That matters beyond neatness: mobile platforms reject cleartext HTTP by
# default (Android network security config, iOS ATS), and over plain HTTP the
# x-api-key header would travel readable to anyone on the path.
#
# Replace 203.0.113.10 below with the VPS public IP (`curl -4 -s ifconfig.me`).
# VPS-DEPLOY.md has a scripted version that substitutes it for you.
#
# Moving to a real domain later means changing this one line and reloading —
# Caddy issues the new certificate on its own.
# ---------------------------------------------------------------------------

203.0.113.10.nip.io {
	# `video_downloader_api` is the container name and 8000 its internal port.
	# Resolved over the uzy_default Docker network, so no host port is involved
	# and nothing can collide with MinIO on 9000 or the uzy services.
	reverse_proxy video_downloader_api:8000 {
		transport http {
			dial_timeout 30s

			# Extraction runs yt-dlp (a few seconds) and a merge job can run for
			# minutes before the first response byte. Caddy's defaults would
			# abort those mid-job.
			response_header_timeout 900s
			read_timeout 900s
			write_timeout 900s
		}
	}

	# cookies.txt uploads. Everything else is a short GET.
	request_body {
		max_size 10MB
	}

	# Deliberately no `encode` directive: the large responses here are mp4
	# files, already compressed. Gzipping them would waste CPU for nothing.
}
